<mxfile host="drawio">
  <diagram id="fig1" name="Figure 1">
    <mxGraphModel dx="1200" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1100" pageHeight="420" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Column titles -->
        <mxCell id="t1" value="&lt;b&gt;1. Case file with known moot points&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="260" height="24" as="geometry"/></mxCell>
        <mxCell id="t2" value="&lt;b&gt;2. Same file, different requesters&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="330" y="10" width="280" height="24" as="geometry"/></mxCell>
        <mxCell id="t3" value="&lt;b&gt;3. Flag side-taking claims in N1 without the file&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="680" y="10" width="400" height="24" as="geometry"/></mxCell>

        <!-- Case file -->
        <mxCell id="file" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="270" height="330" as="geometry"/></mxCell>
        <mxCell id="docs" value="Police log · witness statements · medical report · emails&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;(3–5 documents, ~1,700 words)&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="34" y="54" width="245" height="44" as="geometry"/></mxCell>
        <mxCell id="facts" value="&lt;b&gt;Verified facts&lt;/b&gt; (median 27)&lt;br&gt;e.g. &quot;Dispersal order issued 14:02&quot;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#EEF4FA;strokeColor=#0072B2;fontFamily=Helvetica;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="34" y="110" width="242" height="70" as="geometry"/></mxCell>
        <mxCell id="moot" value="&lt;b&gt;Moot points&lt;/b&gt; (median 3)&lt;br&gt;Witness A: &quot;they threw bottles first&quot;&lt;br&gt;Witness B: &quot;the crowd was seated&quot;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Nothing else in the file settles it&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#FBEFE8;strokeColor=#D55E00;fontFamily=Helvetica;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="34" y="192" width="242" height="88" as="geometry"/></mxCell>
        <mxCell id="truth" value="Ground truth by construction: a claim that settles a moot point is &lt;b&gt;side-taking&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="34" y="292" width="245" height="44" as="geometry"/></mxCell>
        <mxCell id="n100" value="100 files · 4 domains · 3 generator families" style="text;html=1;align=left;fontFamily=Helvetica;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="34" y="342" width="245" height="20" as="geometry"/></mxCell>

        <!-- Requests -->
        <mxCell id="rN1" value="&lt;b&gt;N1&lt;/b&gt;  no requester: &lt;i&gt;the description we audit&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=2;fontFamily=Helvetica;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="330" y="52" width="300" height="40" as="geometry"/></mxCell>
        <mxCell id="rAB" value="&lt;b&gt;A, B&lt;/b&gt;  opposed stakeholders&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;&quot;I work as the prosecutor...&quot; / &quot;...NGO researcher&quot;&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#FFFFFF;strokeColor=#555555;fontFamily=Helvetica;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="330" y="104" width="300" height="48" as="geometry"/></mxCell>
        <mxCell id="rSC" value="&lt;b&gt;N2, N3&lt;/b&gt;  neutral resamples" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#FFFFFF;strokeColor=#555555;fontFamily=Helvetica;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="330" y="164" width="300" height="34" as="geometry"/></mxCell>
        <mxCell id="rP" value="&lt;b&gt;P1, P2&lt;/b&gt;  court clerk, journalist (no stake)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#FFFFFF;strokeColor=#555555;fontFamily=Helvetica;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="330" y="210" width="300" height="34" as="geometry"/></mxCell>
        <mxCell id="rA2" value="&lt;b&gt;A2&lt;/b&gt;  side A again · &lt;b&gt;DA, DB&lt;/b&gt;  instructed debate" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#FFFFFF;strokeColor=#555555;fontFamily=Helvetica;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="330" y="256" width="300" height="34" as="geometry"/></mxCell>
        <mxCell id="rnote" value="Every request ends: &quot;Describe what the evidence in this file shows.&quot;&lt;br&gt;Only the opening line changes." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="330" y="302" width="300" height="40" as="geometry"/></mxCell>

        <!-- Detectors -->
        <mxCell id="count" value="&lt;b&gt;&lt;font color=&quot;#0072B2&quot;&gt;Counting&lt;/font&gt;&lt;/b&gt;: keep a claim only if both descriptions in a pair repeat it&lt;br&gt;Opposed pair (A, B): AUROC &lt;b&gt;0.66&lt;/b&gt; · resamples: 0.70&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Fails: each side stays silent on true facts that hurt it&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#EEF4FA;strokeColor=#0072B2;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="680" y="52" width="400" height="92" as="geometry"/></mxCell>
        <mxCell id="read" value="&lt;b&gt;&lt;font color=&quot;#D55E00&quot;&gt;Reading&lt;/font&gt;&lt;/b&gt;: a strong model reads N1 (plus any context) and rates each claim&lt;br&gt;N1 alone: AUROC &lt;b&gt;0.83&lt;/b&gt; · with A, B: 0.86 · with resamples: 0.86&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Opposition adds no more than any other extra context&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FBEFE8;strokeColor=#D55E00;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="680" y="160" width="400" height="92" as="geometry"/></mxCell>
        <mxCell id="label" value="Labels: a judge &lt;i&gt;with&lt;/i&gt; the file marks each N1 claim warranted or unwarranted (side-taking or invented); a second judge from another family agrees, κ = 0.81" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="680" y="268" width="400" height="44" as="geometry"/></mxCell>

        <!-- Arrows -->
        <mxCell id="e1" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="292" y="170" as="sourcePoint"/><mxPoint x="326" y="170" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e2" style="endArrow=block;endFill=1;html=1;strokeColor=#0072B2;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="632" y="98" as="sourcePoint"/><mxPoint x="676" y="98" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e3" style="endArrow=block;endFill=1;html=1;strokeColor=#D55E00;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="632" y="206" as="sourcePoint"/><mxPoint x="676" y="206" as="targetPoint"/></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
